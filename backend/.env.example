# Qdrant — leave empty to use local on-disk storage at ./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI — used only for difference summary formatting (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# CORS — comma-separated origins; * allowed for local mobile dev
CORS_ORIGINS=*

# Collection
QDRANT_COLLECTION=islamic_corpus

# Optional threshold overrides
# THRESHOLD_AUTHENTIC=0.90
# THRESHOLD_ALTERED=0.85
